{
  "homepage": "https://mrbrodinha.com",
  "name": "mrbrodinha.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*/*.test.mjs",
    "predeploy": "npm run build && npm run security:check && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "security:check": "node tools/security/check-publication.mjs && npm audit --audit-level=low"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "abcjs": "^6.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "smplr": "^1.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.7",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.72.1",
    "globals": "^17.0.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
